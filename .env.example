# Neurocreatives Environment Variables

# Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Telegram session string (RECOMMENDED for Docker / production).
# Generate it once with:  python generate_session_string.py
# The script will fill this variable automatically.
# If empty, the parser falls back to the ./sessions/parser_session.session file.
TELEGRAM_SESSION_STRING=

# Optional: proxy for Telegram connection (if blocked).
# Supported formats:
#   HTTP_PROXY=http://proxy.ru:1234
#   HTTPS_PROXY=http://proxy.ru:1234
#   TELEGRAM_PROXY=socks5://user:pass@host:port
#   TELEGRAM_PROXY=mtproxy://host:port:secret_hex
#   TELEGRAM_PROXY=tg://proxy?secret=...&server=host&port=port  (MTProxy link from Telegram)
# HTTP_PROXY=
# HTTPS_PROXY=
# TELEGRAM_PROXY=

# Optional: VPN (VLESS / Xray) for Telegram connection.
# Paste the full share link exactly as your VPN provider gives it, e.g.:
#   TELEGRAM_VPN=vless://<uuid>@host:443?type=tcp&security=reality&sni=example.com&pbk=<pubkey>&sid=<shortid>&fp=chrome#MyVPN
# The uuid is the VLESS credential (login/password equivalent). Username:password
# auth embedded in the link is also forwarded. A bundled Xray client connects to
# the VLESS server and exposes a local SOCKS5 proxy that Telethon uses
# automatically — no extra configuration needed.
# Requires the 'xray' binary (bundled in the Docker image; set XRAY_BIN to its
# path when running outside Docker). TELEGRAM_VPN takes priority over TELEGRAM_PROXY.
# TELEGRAM_VPN=
# XRAY_BIN=/usr/local/bin/xray

# --- AI Vision backend ---
# The local VLM served by OpenVINO Model Server (OVMS) is the HARD DEFAULT for every
# Vision call. OVMS exposes an OpenAI-compatible endpoint, so the app talks to it via the
# openai SDK with just a base_url swap. A fresh deploy needs NO OpenAI key.
VLM_BASE_URL=http://ovms:8000/v3
VLM_MODEL=qwen2-vl-2b-int4
VLM_API_KEY=unused
# Per-request timeout (seconds). CPU inference is slow — keep generous headroom.
VLM_TIMEOUT=120

# Emergency-only fallback to OpenAI. OFF by default. When true AND OPENAI_API_KEY is set,
# the app retries via OpenAI only if the local VLM call fails / OVMS is unreachable.
AI_FALLBACK_OPENAI=false

# OpenAI API (https://platform.openai.com)
# OPTIONAL and UNUSED on a default deploy — only consumed by the emergency fallback above.
OPENAI_API_KEY=

# Database
# Local development with `docker compose up`:
DATABASE_URL=postgresql://neurocreatives:neurocreatives@db:5432/neurocreatives
# Production (Yandex Cloud Managed PostgreSQL etc.):
# DATABASE_URL=postgresql+psycopg://user:password@host:port/database?sslmode=verify-full&target_session_attrs=read-write

# Server
HOST=0.0.0.0
PORT=8000

# Optional: pre-seed CHANNELS_TO_PARSE (comma-separated list of usernames without @)
# CHANNELS_TO_PARSE=GuerrillaMarketing,Durov,sostav
