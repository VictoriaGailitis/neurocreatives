# Local artifacts not needed inside the image
.git
.gitignore
.github
.venv
venv
env
__pycache__
*.pyc
*.pyo
*.pyd
.DS_Store

# Secrets MUST never leak into the image
.env
.env.*
!.env.example
*.session
*.session-journal
credentials.json
sessions/*.session
*.pem
*.key
id_rsa*
secrets/

# Local data
downloads/*
!downloads/.gitkeep
*.db
*.sqlite
*.sqlite3

# Docs / dev only
*.md
!README.md
.vscode
.idea
backups/
logs/
*.log
